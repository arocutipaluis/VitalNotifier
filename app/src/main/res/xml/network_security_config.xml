<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permitir HTTP en texto plano para comunicación dentro de la red local Wi-Fi con la PC de VitalStock -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
